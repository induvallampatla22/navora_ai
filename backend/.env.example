# NAVORA Travel Platform Configuration
APP_ENV=development
DEBUG=true
DEMO_MODE=true

# Database URL: PostgreSQL in production, SQLite fallback in local dev
DATABASE_URL=sqlite:///./navora.db
# DATABASE_URL=postgresql://navora_user:navora_pass@localhost:5432/navora_db

# Security & Session Authentication
JWT_SECRET_KEY=navora-super-secure-jwt-secret-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Configuration (Gemini API)
GEMINI_API_KEY=

# Maps & Geocoding
GOOGLE_MAPS_API_KEY=

# Weather & Risk Intelligence
OPENWEATHER_API_KEY=

# Live Travel API (Amadeus, etc.)
TRAVEL_API_KEY=
TRAVEL_API_SECRET=

# $
# Email SMTP Provider
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@navora.ai

# Payment Provider (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook Secret
RAZORPAY_WEBHOOK_SECRET=

# Frontend Integration
FRONTEND_URL=http://localhost:3000
